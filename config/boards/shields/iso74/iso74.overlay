/*
 * iso74 - 74-key handwired unibody keyboard
 * Controller: Supermini nRF52840 (nice!nano v2 pin-compatible -> build as nice_nano)
 * Matrix: 6 rows x 15 columns
 * Diodes: one per switch on the column-side leg, anode toward the switch / cathode
 *         (stripe) toward the COLUMN bus => current flows row -> column
 *         => diode-direction = "row2col"
 *
 * In row2col the ROWS are the driven outputs and the COLUMNS are the read inputs,
 * so the pull-down sits on the col-gpios (inputs). Rows are plain active-high outputs.
 *
 * Pins use raw &gpio0 / &gpio1 references (NOT &pro_micro) because three columns land
 * on P1.01 / P1.02 / P1.07 which are not part of the pro-micro connector.
 */

#include <dt-bindings/zmk/matrix_transform.h>

/ {
	chosen {
		zmk,kscan = &kscan0;
		zmk,matrix_transform = &default_transform;
	};

	/*
	 * Real 74-key layout transform, built from the discovery scan. Lists each physical
	 * key in reading order (top-left -> bottom-right) at its firmware (row,col). The
	 * columns were wired in a scrambled order; this remaps them to the real layout.
	 * ISO enter switch = RC(3,12); its top-half slot (physical tab row) has no switch.
	 */
	default_transform: keymap_transform {
		compatible = "zmk,matrix-transform";
		columns = <15>;
		rows = <6>;
		map = <
RC(0,8)  RC(0,9)  RC(0,7)  RC(0,6)  RC(0,5)  RC(0,4)  RC(0,14) RC(0,13) RC(0,0)
RC(1,8)  RC(1,9)  RC(1,11) RC(1,7)  RC(1,6)  RC(1,10) RC(1,5)  RC(1,4)  RC(1,14) RC(1,13) RC(1,0)  RC(1,2)  RC(1,12) RC(1,3)  RC(1,1)
RC(2,8)  RC(2,9)  RC(2,11) RC(2,7)  RC(2,6)  RC(2,10) RC(2,5)  RC(2,4)  RC(2,14) RC(2,13) RC(2,0)  RC(2,2)  RC(2,3)  RC(2,1)
RC(3,8)  RC(3,9)  RC(3,11) RC(3,7)  RC(3,6)  RC(3,10) RC(3,5)  RC(3,4)  RC(3,14) RC(3,13) RC(3,0)  RC(3,2)  RC(3,12) RC(3,3)  RC(3,1)
RC(4,8)  RC(4,9)  RC(4,11) RC(4,7)  RC(4,6)  RC(4,10) RC(4,5)  RC(4,4)  RC(4,14) RC(4,13) RC(4,0)  RC(4,2)  RC(4,12) RC(4,3)  RC(4,1)
RC(5,9)  RC(5,11) RC(5,5)  RC(5,0)  RC(5,2)  RC(5,3)
		>;
	};

	kscan0: kscan {
		compatible = "zmk,kscan-gpio-matrix";
		diode-direction = "row2col";

		/* rows = driven outputs (one bare copper bus per physical row) */
		row-gpios
			= <&gpio0 6  GPIO_ACTIVE_HIGH>   /* row0  P0.06 */
			, <&gpio0 8  GPIO_ACTIVE_HIGH>   /* row1  P0.08 */
			, <&gpio0 17 GPIO_ACTIVE_HIGH>   /* row2  P0.17 */
			, <&gpio0 20 GPIO_ACTIVE_HIGH>   /* row3  P0.20 */
			, <&gpio0 22 GPIO_ACTIVE_HIGH>   /* row4  P0.22 */
			, <&gpio0 24 GPIO_ACTIVE_HIGH>   /* row5  P0.24 */
			;

		/* cols = read inputs (diode side of each switch), pulled low */
		col-gpios
			= <&gpio1 0  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* col0   P1.00 */
			, <&gpio0 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* col1   P0.11 */
			, <&gpio1 4  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* col2   P1.04 */
			, <&gpio1 6  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* col3   P1.06 */
			, <&gpio0 31 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* col4   P0.31 */
			, <&gpio0 29 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* col5   P0.29 */
			, <&gpio0 2  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* col6   P0.02 */
			, <&gpio1 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* col7   P1.15 */
			, <&gpio1 13 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* col8   P1.13 */
			, <&gpio1 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* col9   P1.11 */
			, <&gpio0 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* col10  P0.10 (NFC) */
			, <&gpio0 9  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* col11  P0.09 (NFC) */
			, <&gpio1 1  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* col12  P1.01 */
			, <&gpio1 2  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* col13  P1.02 */
			, <&gpio1 7  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* col14  P1.07 */
			;
	};
};

/*
 * Zephyr 4.1: free the NFC pins (P0.09 = col11, P0.10 = col10) for use as normal
 * GPIO via devicetree. Replaces the removed CONFIG_NFCT_PINS_AS_GPIOS Kconfig.
 */
&uicr {
	nfct-pins-as-gpios;
};
